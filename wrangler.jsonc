{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "haru",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-11-01",
  "observability": {
    "enabled": true,
  },
  "upload_source_maps": true,
  // The Vite build fills in the assets directory.
  "assets": {
    "not_found_handling": "single-page-application",
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "Room",
      },
    ],
  },
  // The Free plan only runs SQLite-backed Durable Objects.
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Room"],
    },
  ],
}
